# ==========================================
# 1. Android 构建产物
# ==========================================
/build/
*/build/
**/build/
out/
*.apk
*.aab
*.ap_
*.dex
*.class
*.so # 如果使用 JNI，编译出的 .so 通常由 CI 重新生成，无需提交

# ==========================================
# 2. 敏感信息与安全凭证
# ==========================================
# 签名密钥
*.jks
*.keystore
*.pem
*.p12
*.p8

# 密钥配置文件 (通常包含 storePassword, keyPassword 等)
keystore.properties
signing.properties

# 本地环境变量与 API 密钥
.env
.env.local
# NDK 路径或 SDK 路径等本地配置，不应污染团队
local.properties


# ==========================================
# 3. IDE 与编辑器配置 (避免团队互相干扰)
# ==========================================
# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
.gradle/

# VSCode (部分开发者可能使用)
.vscode/

# ==========================================
# 4. Gradle 缓存与包管理
# ==========================================
.gradle
/local.properties
/.gradle/caches/
/.gradle/notifications/

# NDK 编译产物
obj/
# 通常是放置第三方 .jar 或 .so 的地方，但现在推荐用 Maven 依赖，如果是空目录则忽略
libs/

# ==========================================
# 5. 日志、临时文件与测试报告
# ==========================================
*.log
# 内存泄漏分析产物 (Dump 文件，体积巨大)
*.hprof
# 性能分析捕获文件
captures/
*.swp
*~

# 测试与覆盖率
coverage/
*.lcov

# ==========================================
# 6. 数据导出、备份、本地脚本
# ==========================================
# 数据库与本地测试数据
*.db
*.sqlite
*.csv

# 压缩包与备份 (不应放在源码管理中)
*.zip
*.tar.gz
*.bak

# 开发者个人的快捷脚本
*.local.sh
